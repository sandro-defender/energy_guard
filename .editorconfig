# EditorConfig: https://editorconfig.org
# Matches the tooling already configured in pyproject.toml (ruff):
# Python is formatted with a 4-space indent, the panel JS uses 2 spaces.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{js,yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
